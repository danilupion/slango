{
  "name": "@slango/ristretto",
  "version": "1.0.64",
  "private": false,
  "description": "Opinionated rest client",
  "repository": {
    "type": "git",
    "url": "https://github.com/danilupion/slango",
    "directory": "packages/ristretto"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./abortable": {
      "import": "./dist/abortable/index.js",
      "types": "./dist/abortable/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:force": "tsc -p tsconfig.build.json --incremental false",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@slango/tessera": "workspace:*"
  },
  "devDependencies": {
    "@slango.configs/oxlint": "workspace:*",
    "@slango.configs/typescript": "workspace:*",
    "@slango.configs/vitest": "workspace:*",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "type-fest": "5.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
