{
  "name": "@slango.configs/vitest",
  "version": "2.1.0",
  "private": false,
  "description": "Slango vitest configs",
  "repository": {
    "type": "git",
    "url": "https://github.com/danilupion/slango",
    "directory": "configs/vitest"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./dist/presets/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 ."
  },
  "dependencies": {
    "@swc/core": "1.16.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "unplugin-swc": "2.0.0"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@slango.configs/oxlint": "workspace:*",
    "@slango.configs/typescript": "workspace:*",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
